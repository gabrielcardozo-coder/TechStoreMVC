@* Passo 3 - riar as views *@
@* Se estou na View(index) de produtos, qual sera a model que eu vou usar? *@
@model List<TechStoreMVC.Models.Produto>
    <h1>Lista de Produtos</h1>
  
  @{
    ViewData["Title"] = "Produtos";
  }
  
  
  <table class="table table-striped">
        <thead>
            <tr>
                <th>id</th>
                <th>Nome</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produto in Model)
            {
                <tr>
                    <td>@produto.Id</td>
                    <td>@produto.Nome</td>
                    <td>R$ @produto.Preco.ToString("F2")</td>
                    <td>@produto.Estoque</td>
                    <td>
                        <button class="btn btn-primary">Detalhes</button>
                    </td> 
                </tr>
            }
        </tbody>
    </table>